# Only values that must be set locally live here. Every other knob (base URLs,
# models, providers, endpoint templates, timeouts) already has a sane default in
# application.yml — add an override only if you actually need a non-default value.
#
# How it works:
#   Each property in application.yml uses ${ENV_VAR:default} syntax. If the
#   corresponding environment variable is NOT set, the default value from
#   application.yml is used automatically. Setting it here (or exporting it in
#   your shell) overrides the default. Comment out or delete any line below to
#   fall back to the application.yml default.

# --- Database ---
POSTGRES_DB=saveapenny
POSTGRES_USER=saveapenny_app
POSTGRES_PASSWORD=change_me_local_only
DB_USERNAME=saveapenny_app
DB_PASSWORD=change_me_local_only

# --- Flyway ---
FLYWAY_ENABLED=true

# --- Security ---
JWT_SECRET=change_me_to_a_64_plus_char_secret_for_hs512_signing_key
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Rate Limit ---
RATE_LIMIT_LOGIN_MAX_PER_MINUTE=5
RATE_LIMIT_API_MAX_PER_MINUTE=60

# --- AI Assistant (OpenRouter) ---
ASSISTANT_ENABLED=false
ASSISTANT_MAX_HISTORY=8
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=

# --- Goal Progress ---
GOAL_PROGRESS_ENABLED=false
GOAL_PROGRESS_OFF_TRACK_RATIO=0.10
GOAL_PROGRESS_AT_RISK_RATIO=0.05
GOAL_PROGRESS_OFF_TRACK_PERSISTENCE_MONTHS=2
GOAL_PROGRESS_CRON=0 0 6 * * *

# --- Insight ---
INSIGHT_ENABLED=false
INSIGHT_CRON=0 30 6 * * *
INSIGHT_MAX_INSIGHTS_PER_GENERATION=10
INSIGHT_DEDUPLICATION_WINDOW_DAYS=7
INSIGHT_STDDEV_THRESHOLD=3.0
INSIGHT_MAX_AMOUNT_RATIO=0.5
INSIGHT_AI_ENHANCED=false

# --- OCR ---
OCR_ENABLED=false
OCR_LANGUAGE=eng
OCR_PSM=3
OCR_MAX_FILE_SIZE_BYTES=10485760
OCR_JOB_TIMEOUT_MILLIS=30000
OCR_MAX_RETRIES=2
OCR_DEBUG_LOGGING=false

# --- Stocks (Alpha Vantage) ---
# Enabled by default in application.yml; forced off here until a key is set.
STOCK_ENABLED=false
ALPHA_VANTAGE_API_KEY=
STOCK_BASE_URL=https://www.alphavantage.co
STOCK_RATE_LIMIT_PER_MINUTE=5
STOCK_RATE_LIMIT_PER_DAY=25

# --- RevenueCat billing ---
REVENUECAT_ENABLED=false
REVENUECAT_SECRET_API_KEY=

# --- Firebase Analytics ---
FIREBASE_ANALYTICS_ENABLED=false
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_SECRET=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_API_SECRET=

# --- Push notifications (FCM) ---
PUSH_FCM_ENABLED=false
# Required when FCM is enabled. Point this at a non-committed service-account
# JSON, e.g. file:/etc/secrets/firebase.json
PUSH_FCM_CREDENTIALS_PATH=
